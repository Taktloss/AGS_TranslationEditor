<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:AGSFontEditor.Localization"
        x:Class="AGS_TranslationEditor.Views.AboutDialog"
        Title="{l:T 'About AGS Translation Editor'}"
        Width="360" Height="220"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">

  <StackPanel Margin="24" Spacing="8" VerticalAlignment="Center">
    <TextBlock Text="{l:T 'AGS Translation Editor'}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
    <TextBlock Text="{l:T 'Version 2.0 (Avalonia)'}" HorizontalAlignment="Center" Foreground="#666" />
    <TextBlock Text="{l:T 'Cross-platform translation editor for Adventure Game Studio games.'}" 
               TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8" />
    <TextBlock Text="{l:T '© 2015 Bernd Keilmann'}" HorizontalAlignment="Center" Foreground="#666" />
    <Button Content="{l:T 'OK'}" HorizontalAlignment="Center" Margin="0,12,0,0" Width="80" Name="BtnOK" />
  </StackPanel>
</Window>
