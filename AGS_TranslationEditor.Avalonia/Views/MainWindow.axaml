<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:AGSFontEditor.Localization"
        xmlns:vm="using:AGS_TranslationEditor.ViewModels"
        xmlns:models="using:AGS_TranslationEditor.Models"
        xmlns:agstools="using:AGSTools"
        xmlns:conv="using:AGS_TranslationEditor.Converters"
        xmlns:ic="using:AGSFontEditor.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="AGS_TranslationEditor.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Width="1100" Height="700"
        MinWidth="750" MinHeight="500"
        Background="{DynamicResource Th.Bg}">

  <Window.Resources>
    <conv:BoolToBackgroundConverter x:Key="BoolToBg" />
  </Window.Resources>

  <DockPanel>

    <!-- ═══ Header: menu and toolbar on one surface ═══ -->
    <Border DockPanel.Dock="Top"
            Background="{DynamicResource Th.Panel}"
            BorderBrush="{DynamicResource Th.BorderSubtle}"
            BorderThickness="0,0,0,1">
     <StackPanel>
      <Menu Background="Transparent" Margin="4,0" Foreground="{DynamicResource Th.Text}">
        <MenuItem Header="{l:T '_File'}">
          <MenuItem Header="{l:T '_Open...'}" Command="{Binding Files.OpenCommand}" InputGesture="Ctrl+O">
            <MenuItem.Icon><ic:LineIcon Data="{StaticResource I.Open}" /></MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="{l:T '_Save'}" Command="{Binding Files.SaveCommand}" InputGesture="Ctrl+S">
            <MenuItem.Icon><ic:LineIcon Data="{StaticResource I.Save}" /></MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="{l:T 'Save _As...'}" Command="{Binding Files.SaveAsCommand}" InputGesture="Ctrl+Shift+S">
            <MenuItem.Icon><ic:LineIcon Data="{StaticResource I.SaveAs}" /></MenuItem.Icon>
          </MenuItem>
          <Separator />
          <MenuItem Header="{l:T '_Export'}" IsEnabled="{Binding HasEntries}">
            <MenuItem.Icon><ic:LineIcon Data="{StaticResource I.Export}" /></MenuItem.Icon>
            <MenuItem Header="{l:T 'Export as CSV...'}" Command="{Binding Files.ExportCsvCommand}">
              <MenuItem.Icon><ic:LineIcon Data="{StaticResource I.File}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{l:T 'Export as PO...'}" Command="{Binding Files.ExportPoCommand}">
              <MenuItem.Icon><ic:LineIcon Data="{StaticResource I.File}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{l:T 'Export as _TRA...'}" Command="{Binding Game.ExportTraCommand}">
              <MenuItem.Icon><ic:LineIcon Data="{StaticResource I.File}" /></MenuItem.Icon>
            </MenuItem>
          </MenuItem>
          <Separator />
          <MenuItem Header="{l:T 'E_xit'}" Name="MenuExit">
            <MenuItem.Icon><ic:LineIcon Data="{StaticResource I.Exit}" /></MenuItem.Icon>
          </MenuItem>
        </MenuItem>
        <MenuItem Header="{l:T '_Edit'}">
          <MenuItem Header="{l:T '_Undo'}" Command="{Binding UndoCommand}" InputGesture="Ctrl+Z">
            <MenuItem.Icon><ic:LineIcon Data="{StaticResource I.Undo}" /></MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="{l:T '_Redo'}" Command="{Binding RedoCommand}" InputGesture="Ctrl+Y">
            <MenuItem.Icon><ic:LineIcon Data="{StaticResource I.Redo}" /></MenuItem.Icon>
          </MenuItem>
        </MenuItem>
        <MenuItem Header="{l:T '_Tools'}">
          <MenuItem Header="{l:T '_Extract Strings...'}" Command="{Binding Game.ExtractCommand}">
            <MenuItem.Icon><ic:LineIcon Data="{StaticResource I.File}" /></MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="{l:T '_Game Info...'}" Command="{Binding Game.ShowGameInfoCommand}">
            <MenuItem.Icon><ic:LineIcon Data="{StaticResource I.Info}" /></MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="{l:T 'Create _TRA File...'}" Command="{Binding Game.CreateTraCommand}">
            <MenuItem.Icon><ic:LineIcon Data="{StaticResource I.FilePlus}" /></MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="{l:T '_Update from Game...'}" Command="{Binding Game.MergeWithGameCommand}">
            <MenuItem.Icon><ic:LineIcon Data="{StaticResource I.Refresh}" /></MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="{l:T '_Check Translation...'}" Command="{Binding Game.CheckCommand}">
            <MenuItem.Icon><ic:LineIcon Data="{StaticResource I.Check}" /></MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="{l:T 'Check Grammar with _LanguageTool...'}" Command="{Binding Ai.CheckGrammarCommand}">
            <MenuItem.Icon><ic:LineIcon Data="{StaticResource I.Grammar}" /></MenuItem.Icon>
          </MenuItem>
          <Separator />
          <MenuItem Header="{l:T '_Install into Game...'}" Command="{Binding Game.InstallCommand}">
            <MenuItem.Icon><ic:LineIcon Data="{StaticResource I.Download}" /></MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="{l:T 'U_ninstall from Game...'}" Command="{Binding Game.UninstallCommand}">
            <MenuItem.Icon><ic:LineIcon Data="{StaticResource I.Trash}" /></MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="{l:T 'Create _Player Package...'}" Command="{Binding Game.CreatePlayerPackageCommand}">
            <MenuItem.Icon><ic:LineIcon Data="{StaticResource I.Package}" /></MenuItem.Icon>
          </MenuItem>
          <Separator />
          <MenuItem Header="{l:T '_Font Editor...'}" Name="MenuFontEditor">
            <MenuItem.Icon><ic:LineIcon Data="{StaticResource I.Type}" /></MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="{l:T '_Image Editor...'}" Name="MenuSpriteEditor">
            <MenuItem.Icon><ic:LineIcon Data="{StaticResource I.Image}" /></MenuItem.Icon>
          </MenuItem>
          <Separator />
          <MenuItem Header="{l:T '_Settings...'}" Name="MenuSettings">
            <MenuItem.Icon><ic:LineIcon Data="{StaticResource I.Settings}" /></MenuItem.Icon>
          </MenuItem>
        </MenuItem>
        <MenuItem Header="{l:T '_AI'}">
          <MenuItem Header="{l:T '_Translate Empty Entries...'}" Command="{Binding Ai.TranslateEmptyCommand}">
            <MenuItem.Icon><ic:LineIcon Data="{StaticResource I.Sparkle}" /></MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="{l:T 'Translate Selected _Entry Again'}" Command="{Binding Ai.TranslateSelectedCommand}">
            <MenuItem.Icon><ic:LineIcon Data="{StaticResource I.Refresh}" /></MenuItem.Icon>
          </MenuItem>
          <Separator />
          <MenuItem Header="{l:T '_Review Translation...'}" Command="{Binding Ai.ReviewCommand}">
            <MenuItem.Icon><ic:LineIcon Data="{StaticResource I.Eye}" /></MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="{l:T 'Review _Selected Entry'}" Command="{Binding Ai.ReviewSelectedCommand}">
            <MenuItem.Icon><ic:LineIcon Data="{StaticResource I.Check}" /></MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="{l:T '_Shorten Texts That Do Not Fit...'}" Command="{Binding Ai.ShortenCommand}">
            <MenuItem.Icon><ic:LineIcon Data="{StaticResource I.Shorten}" /></MenuItem.Icon>
          </MenuItem>
        </MenuItem>
        <MenuItem Header="{l:T '_Help'}">
          <MenuItem Header="{l:T '_About'}" Name="MenuAbout">
            <MenuItem.Icon><ic:LineIcon Data="{StaticResource I.Info}" /></MenuItem.Icon>
          </MenuItem>
        </MenuItem>
      </Menu>

      <!-- Toolbar -->
      <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,2,8,8">

        <!-- File -->
        <Button Command="{Binding Files.OpenCommand}" ToolTip.Tip="{l:T 'Open (Ctrl+O)'}" Classes="vsbtn">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ic:LineIcon Data="{StaticResource I.Open}" />
            <TextBlock Text="{l:T 'Open'}" />
          </StackPanel>
        </Button>
        <Button Command="{Binding Files.SaveCommand}" ToolTip.Tip="{l:T 'Save (Ctrl+S)'}" Classes="vsbtn">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ic:LineIcon Data="{StaticResource I.Save}" />
            <TextBlock Text="{l:T 'Save'}" />
          </StackPanel>
        </Button>

        <Rectangle Classes="divider" />

        <!-- Search -->
        <Border Classes="field" IsEnabled="{Binding HasEntries}">
          <StackPanel Orientation="Horizontal">
            <ic:LineIcon Data="{StaticResource I.Search}" VerticalAlignment="Center" />
            <TextBox Name="TxtSearch"
                     Text="{Binding SearchText}"
                     Width="190"
                     Watermark="{l:T 'Search...'}" />
          </StackPanel>
        </Border>
        <Button Command="{Binding FindPreviousCommand}" Classes="vsbtn icon" Margin="4,0,0,0" ToolTip.Tip="{l:T 'Previous match'}" ToolTip.ShowDelay="300">
          <ic:LineIcon Data="{StaticResource I.Up}" />
        </Button>
        <Button Command="{Binding FindNextCommand}" Classes="vsbtn icon" ToolTip.Tip="{l:T 'Next match'}" ToolTip.ShowDelay="300">
          <ic:LineIcon Data="{StaticResource I.Down}" />
        </Button>

        <Rectangle Classes="divider" />

        <!-- Filter -->
        <ToggleButton Name="BtnFilterUntranslated" IsChecked="{Binding FilterUntranslated}" IsEnabled="{Binding HasEntries}" ToolTip.Tip="{l:T 'Show only untranslated entries'}" Classes="vsbtn">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ic:LineIcon Data="{StaticResource I.Filter}" />
            <TextBlock Text="{l:T 'Untranslated only'}" />
          </StackPanel>
        </ToggleButton>
        <Button Command="{Binding JumpToNextUntranslatedCommand}" Classes="vsbtn icon" Margin="2,0,0,0"
                ToolTip.Tip="{l:T 'Jump to next untranslated (F3)'}">
          <ic:LineIcon Data="{StaticResource I.NextEmpty}" />
        </Button>
        <Border Classes="field" Margin="6,0,0,0" IsVisible="{Binding IsContextVisible}">
          <TextBox Width="140"
                   Text="{Binding ContextFilter}"
                   Watermark="{l:T 'Character or room...'}"
                   ToolTip.Tip="{l:T 'Show only texts whose context contains this, e.g. a character or a room'}" />
        </Border>

        <Rectangle Classes="divider" />
        <Button Command="{Binding Ai.TranslateCommand}" ToolTip.Tip="{l:T 'Machine-translate the selected entry, or all empty entries (service: Settings)'}" Classes="vsbtn">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ic:LineIcon Data="{StaticResource I.Sparkle}" Classes="accent" />
            <TextBlock Text="{l:T 'Translate'}" />
          </StackPanel>
        </Button>
        <ToggleButton Margin="2,0,0,0" IsChecked="{Binding Progress.IsVisible}" IsEnabled="{Binding HasEntries}" ToolTip.Tip="{l:T 'Progress per room, script or character; click one to show only its texts'}" Classes="vsbtn">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ic:LineIcon Data="{StaticResource I.Chart}" />
            <TextBlock Text="{l:T 'Progress'}" />
          </StackPanel>
        </ToggleButton>

        <Rectangle Classes="divider" />
        <ToggleButton Name="BtnLive" IsChecked="{Binding Live.IsActive}" ToolTip.Tip="{l:T 'Live mode: see the texts of the running game and correct them while playing (Linux and Windows)'}" Classes="vsbtn">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ic:LineIcon Data="{StaticResource I.Live}" Classes="live" />
            <TextBlock Text="{l:T 'Live'}" />
          </StackPanel>
        </ToggleButton>

      </WrapPanel>
     </StackPanel>
    </Border>

    <!-- ═══ Status Bar ═══ -->
    <Border DockPanel.Dock="Bottom"
            Background="{DynamicResource Th.Panel}"
            BorderBrush="{DynamicResource Th.BorderSubtle}"
            BorderThickness="0,1,0,0"
            Height="26">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,160" Margin="10,0">

        <!-- Left: unsaved changes -->
        <Ellipse Grid.Column="0" Width="7" Height="7" Margin="0,0,8,0"
                 Fill="{DynamicResource Th.Warning}"
                 VerticalAlignment="Center"
                 ToolTip.Tip="{l:T 'Unsaved changes'}"
                 IsVisible="{Binding DocumentChanged}" />

        <!-- Center: status message -->
        <TextBlock Grid.Column="1"
                   Text="{Binding FileStatusText}"
                   Foreground="{DynamicResource Th.TextMuted}"
                   TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center"
                   FontSize="11" />

        <!-- Cancel running AI work -->
        <Button Grid.Column="2" Content="{l:T 'Cancel'}" IsVisible="{Binding IsAiBusy}"
                Command="{Binding CancelAiCommand}" FontSize="11" Padding="10,0" Height="20" Margin="0,0,12,0"
                CornerRadius="10"
                VerticalAlignment="Center" VerticalContentAlignment="Center"
                Background="{DynamicResource Th.AccentMuted}" Foreground="{DynamicResource Th.TextStrong}"
                ToolTip.Tip="{l:T 'Stop the AI service; what is done so far is kept'}" />

        <!-- Right: entry count -->
        <TextBlock Grid.Column="3"
                   Text="{Binding EntriesCountText}"
                   Foreground="{DynamicResource Th.Text}"
                   VerticalAlignment="Center"
                   FontSize="11"
                   FontWeight="SemiBold"
                   Margin="0,0,12,0" />

        <!-- Progress -->
        <ProgressBar Grid.Column="4"
                     Value="{Binding ProgressValue}"
                     Minimum="0" Maximum="100"
                     Height="6" MinHeight="6" MinWidth="0"
                     VerticalAlignment="Center"
                     Background="{DynamicResource Th.BorderSubtle}"
                     Foreground="{DynamicResource Th.Accent}"
                     CornerRadius="3" />
      </Grid>
    </Border>

    <!-- ═══ Check Panel ═══ -->
    <Border DockPanel.Dock="Right" Classes="sidepanel"
            IsVisible="{Binding ShowCheckPanel}">
      <DockPanel>
        <Border DockPanel.Dock="Top"
                Padding="12,10"
                BorderBrush="{DynamicResource Th.BorderSubtle}"
                BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="4">
              <TextBlock Text="{l:T 'CHECK'}" Classes="paneltitle" />
              <TextBlock Text="{Binding CheckSummary}"
                         FontSize="11"
                         Foreground="{DynamicResource Th.TextMuted}"
                         TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="11" Padding="8,2"
                    Content="{l:T 'Apply All'}" IsVisible="{Binding HasOpenSuggestions}"
                    Command="{Binding ApplyAllSuggestionsCommand}"
                    ToolTip.Tip="{l:T 'Put every AI suggestion into its entry'}" />
            <Button Grid.Column="1" Classes="vsbtn icon small" VerticalAlignment="Top"
                    Command="{Binding CloseCheckPanelCommand}"
                    ToolTip.Tip="{l:T 'Close'}">
              <ic:LineIcon Data="{StaticResource I.Close}" Width="14" Height="14" />
            </Button>
          </Grid>
        </Border>
        <ListBox Name="LstCheck"
                 ItemsSource="{Binding CheckItems}"
                 SelectedItem="{Binding SelectedCheckItem}"
                 Background="{DynamicResource Th.Bg}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="models:CheckItem">
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding Header}"
                           Foreground="{Binding Color}"
                           FontSize="11" />
                <TextBlock Text="{Binding Text}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource Th.TextBright}"
                           FontSize="12" />
                <TextBlock Text="{Binding Message}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource Th.TextMuted}"
                           FontSize="11" />
                <Border IsVisible="{Binding HasSuggestion}" Background="{DynamicResource Th.SuccessBg}" CornerRadius="6" Padding="8,6" Margin="0,2,0,0">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Suggestion}" TextWrapping="Wrap" Foreground="{DynamicResource Th.SuccessText}" FontSize="12" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="{l:T 'Apply'}" FontSize="11" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Top"
                            IsVisible="{Binding CanApply}" CommandParameter="{Binding}"
                            Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).ApplySuggestionCommand}" />
                    <TextBlock Grid.Column="1" Text="✓" Foreground="{DynamicResource Th.Success}" IsVisible="{Binding IsApplied}" Margin="6,0,0,0" />
                  </Grid>
                </Border>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- ═══ Progress Panel ═══ -->
    <Border DockPanel.Dock="Right" Classes="sidepanel"
            IsVisible="{Binding Progress.IsVisible}">
      <DockPanel>
        <Border DockPanel.Dock="Top"
                Padding="12,10"
                BorderBrush="{DynamicResource Th.BorderSubtle}"
                BorderThickness="0,0,0,1">
          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{l:T 'PROGRESS'}" Classes="paneltitle" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="vsbtn icon small"
                      Command="{Binding Progress.CloseCommand}"
                      ToolTip.Tip="{l:T 'Close'}">
                <ic:LineIcon Data="{StaticResource I.Close}" Width="14" Height="14" />
              </Button>
            </Grid>
            <TextBlock Text="{Binding Progress.Summary}"
                       FontSize="11"
                       Foreground="{DynamicResource Th.TextMuted}"
                       TextWrapping="Wrap" />
            <ComboBox SelectedIndex="{Binding Progress.GroupingIndex}"
                      FontSize="11"
                      HorizontalAlignment="Stretch"
                      IsVisible="{Binding Progress.HasContext}">
              <ComboBoxItem Content="{l:T 'By room or script'}" />
              <ComboBoxItem Content="{l:T 'By character'}" />
            </ComboBox>
            <Button Classes="vsbtn"
                    FontSize="11"
                    HorizontalAlignment="Left"
                    Content="{l:T 'Show all texts again'}"
                    Command="{Binding Progress.ClearFilterCommand}"
                    IsVisible="{Binding Progress.SelectedRow, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <StackPanel Spacing="6" IsVisible="{Binding !Progress.HasContext}">
              <Border Classes="hint">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                  <ic:LineIcon Data="{StaticResource I.Info}" />
                  <TextBlock Grid.Column="1"
                             Text="{l:T 'For rooms and characters the editor needs to know where each text comes from. It reads that from the game once and keeps it next to the translation (.context.json).'}" />
                </Grid>
              </Border>
              <Button Command="{Binding Game.ReadOriginsCommand}"
                      Classes="vsbtn"
                      FontSize="11"
                      HorizontalAlignment="Left"
                      Content="{l:T 'Read origins from the game...'}" />
            </StackPanel>
          </StackPanel>
        </Border>
        <ListBox ItemsSource="{Binding Progress.Rows}"
                 SelectedItem="{Binding Progress.SelectedRow}"
                 Background="{DynamicResource Th.Bg}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ProgressRow">
              <StackPanel Spacing="3">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                  <TextBlock Text="{Binding DisplayName}"
                             TextTrimming="CharacterEllipsis"
                             Foreground="{DynamicResource Th.TextBright}"
                             FontSize="12" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding Counts}"
                             Foreground="{DynamicResource Th.TextMuted}"
                             FontSize="11" />
                </Grid>
                <ProgressBar Value="{Binding Percent}"
                             Maximum="100"
                             Height="4"
                             MinHeight="4"
                             Classes.done="{Binding IsDone}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- ═══ Live Panel ═══ -->
    <Border DockPanel.Dock="Right" Classes="sidepanel"
            IsVisible="{Binding Live.IsActive}">
      <DockPanel>
        <Border DockPanel.Dock="Top"
                Padding="12,10"
                BorderBrush="{DynamicResource Th.BorderSubtle}"
                BorderThickness="0,0,0,1">
          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{l:T 'LIVE'}" Classes="paneltitle" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="vsbtn icon small"
                      Command="{Binding Live.CloseCommand}"
                      ToolTip.Tip="{l:T 'Close'}">
                <ic:LineIcon Data="{StaticResource I.Close}" Width="14" Height="14" />
              </Button>
            </Grid>
            <TextBlock Text="{Binding Live.StatusText}"
                       FontSize="11"
                       Foreground="{DynamicResource Th.TextMuted}"
                       TextWrapping="Wrap" />
            <Border Background="{DynamicResource Th.Input}" CornerRadius="4" Padding="8,5"
                    IsVisible="{Binding Live.StartCommand, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <SelectableTextBlock Text="{Binding Live.StartCommand}"
                                   FontFamily="Cascadia Code,Consolas,monospace"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource Th.Text}" />
            </Border>
            <ComboBox HorizontalAlignment="Stretch"
                      FontSize="12"
                      ItemsSource="{Binding Live.RunningGames}"
                      SelectedItem="{Binding Live.SelectedGame}"
                      PlaceholderText="{l:T 'No game found'}"
                      ToolTip.Tip="{l:T 'AGS games running on this computer'}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="agstools:RunningGame">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{Binding Name}" />
                    <TextBlock Text="{Binding ProcessId, StringFormat='({0})'}" Foreground="{DynamicResource Th.TextMuted}" />
                    <TextBlock Text="{l:T 'live'}" Foreground="{DynamicResource Th.Accent}" IsVisible="{Binding IsHooked}" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
              <Button Classes="vsbtn icon"
                      Command="{Binding Live.RefreshGamesCommand}"
                      ToolTip.Tip="{l:T 'Look for running games again'}">
                <ic:LineIcon Data="{StaticResource I.Refresh}" Width="14" Height="14" />
              </Button>
              <Button FontSize="12"
                      Content="{l:T 'Attach'}"
                      Command="{Binding Live.AttachCommand}"
                      ToolTip.Tip="{l:T 'Load the live hook into the running game, without restarting it'}" />
            </StackPanel>
            <CheckBox IsChecked="{Binding Live.AutoSave}"
                      Content="{l:T 'Save the TRS after each correction'}" />
            <CheckBox IsChecked="{Binding Live.ShowPreview}"
                      Content="{l:T 'Preview with the game font'}"
                      ToolTip.Tip="{l:T 'Draws the selected text (or the newest) with a font of the game, so a correction can be seen at once.'}" />
            <StackPanel Spacing="4" IsVisible="{Binding Live.ShowPreview}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                <ComboBox Grid.Column="0"
                          HorizontalAlignment="Stretch"
                          FontSize="11"
                          ItemsSource="{Binding Live.PreviewFonts}"
                          SelectedItem="{Binding Live.PreviewFont}"
                          PlaceholderText="{l:T 'No fonts loaded'}"
                          ToolTip.Tip="{l:T 'Font for the preview, e.g. the speech font'}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="agstools:GameFont">
                      <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="1"
                        Command="{Binding Game.PickPreviewGameCommand}"
                        Classes="vsbtn"
                        FontSize="11"
                        Content="{l:T 'Game...'}"
                        ToolTip.Tip="{l:T 'Choose the game file whose fonts are used (adjusted fonts in the game folder are used first, like in the game)'}" />
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="4">
                <CheckBox IsChecked="{Binding Live.WrapLikeGame}"
                          VerticalAlignment="Center"
                          Content="{l:T 'Wrap like the game at'}"
                          ToolTip.Tip="{l:T 'Wraps long lines at spaces, roughly where the game does: about 70 % of the screen width, estimated from the game resolution. Games that draw speech by script or with a portrait can wrap a little earlier; set the width to what you see in the game. The blue line marks it.'}" />
                <NumericUpDown Value="{Binding Live.WrapWidth}"
                               Minimum="16" Maximum="4000" Increment="4"
                               FormatString="0"
                               ShowButtonSpinner="False"
                               FontSize="11" Width="56"
                               IsEnabled="{Binding Live.WrapLikeGame}" />
                <TextBlock Text="px" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource Th.Text}" />
                <Button Classes="vsbtn icon small"
                        Command="{Binding Live.ResetWrapWidthCommand}"
                        IsEnabled="{Binding Live.WrapLikeGame}"
                        ToolTip.Tip="{l:T 'Back to the estimate from the game resolution'}">
                  <ic:LineIcon Data="{StaticResource I.Undo}" Width="14" Height="14" />
                </Button>
              </StackPanel>
              <Border Background="#1E1E1E"
                      Padding="4"
                      IsVisible="{Binding Live.PreviewImage, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Image Source="{Binding Live.PreviewImage}"
                       Stretch="Uniform"
                       StretchDirection="DownOnly"
                       HorizontalAlignment="Left"
                       MaxHeight="220"
                       RenderOptions.BitmapInterpolationMode="None" />
              </Border>
              <Border Classes="hint" IsVisible="{Binding Live.PreviewNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                  <ic:LineIcon Data="{StaticResource I.Info}" />
                  <TextBlock Grid.Column="1" Text="{Binding Live.PreviewNote}" />
                </Grid>
              </Border>
            </StackPanel>
          </StackPanel>
        </Border>
        <ListBox Name="LstLive"
                 ItemsSource="{Binding Live.Items}"
                 SelectedItem="{Binding Live.SelectedItem}"
                 Background="{DynamicResource Th.Bg}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="models:LiveItem">
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding Shown}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource Th.TextBright}"
                           FontSize="12" />
                <TextBlock Text="{Binding Original}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource Th.TextMuted}"
                           FontSize="11" />
                <TextBlock Text="{Binding Note}"
                           Foreground="{DynamicResource Th.Info}"
                           FontSize="11"
                           IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- ═══ Main Content ═══ -->
    <Grid Name="MainContentGrid">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" MinHeight="120" />
        <RowDefinition Height="4" />
        <RowDefinition Height="170" MinHeight="90" />
      </Grid.RowDefinitions>

      <!-- Translation List -->
      <Grid Grid.Row="0">
        <DataGrid Name="DgvTranslation"
                  ItemsSource="{Binding DisplayedEntries}"
                  SelectedItem="{Binding SelectedEntry}"
                  AutoGenerateColumns="False"
                  CanUserSortColumns="True"
                  CanUserResizeColumns="True"
                  SelectionMode="Single">
          <DataGrid.Styles>
            <Style Selector="DataGridRow" x:DataType="models:TranslationEntry">
              <Setter Property="Background"
                      Value="{Binding IsUntranslated, Converter={StaticResource BoolToBg}}" />
            </Style>
          </DataGrid.Styles>
          <DataGrid.Columns>
            <DataGridTextColumn Header="#"
                                Binding="{Binding RowIndex}"
                                Width="56"
                                CanUserSort="False"
                                IsReadOnly="True">
              <DataGridTextColumn.CellTheme>
                <ControlTheme TargetType="DataGridCell">
                  <Setter Property="Foreground" Value="{DynamicResource Th.TextDim}" />
                  <Setter Property="FontSize" Value="11" />
                </ControlTheme>
              </DataGridTextColumn.CellTheme>
            </DataGridTextColumn>
            <DataGridTextColumn Header="{l:T 'Source (Original)'}"
                                Binding="{Binding Key}"
                                Width="*"
                                IsReadOnly="True" />
            <DataGridTextColumn Header="{l:T 'Translation'}"
                                Binding="{Binding Value}"
                                Width="*" />
            <!-- Shown by code when context is enabled: columns are not part of the visual tree -->
            <DataGridTextColumn Header="{l:T 'Context'}"
                                Binding="{Binding Origin}"
                                Width="200"
                                IsReadOnly="True"
                                IsVisible="False">
              <DataGridTextColumn.CellTheme>
                <ControlTheme TargetType="DataGridCell">
                  <Setter Property="Foreground" Value="{DynamicResource Th.TextMuted}" />
                  <Setter Property="FontSize" Value="11" />
                </ControlTheme>
              </DataGridTextColumn.CellTheme>
            </DataGridTextColumn>
          </DataGrid.Columns>
        </DataGrid>

        <!-- Loading overlay -->
        <Border Background="{DynamicResource Th.Overlay}" IsVisible="{Binding IsLoading}" ZIndex="10">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
            <ProgressBar IsIndeterminate="True" Width="200" Height="4" />
            <TextBlock Text="{l:T 'Loading...'}" Foreground="{DynamicResource Th.Text}" HorizontalAlignment="Center" FontSize="13"/>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Drag handle -->
      <GridSplitter Grid.Row="1"
                    ResizeDirection="Rows"
                    Background="{DynamicResource Th.BorderSubtle}"
                    Height="4" />

      <!-- ═══ Editor Panel ═══ -->
      <Border Grid.Row="2" Background="{DynamicResource Th.Panel}">
        <Grid RowDefinitions="*">

          <!-- Source + Translation side by side -->
          <Grid ColumnDefinitions="*,1,*">

            <!-- Source -->
            <DockPanel Margin="0">
              <Border DockPanel.Dock="Top"
                      Background="{DynamicResource Th.Panel}"
                      Padding="12,6,12,2">
                <TextBlock Text="{l:T 'SOURCE'}" Classes="edlabel" />
              </Border>
              <TextBox Text="{Binding SourceText}"
                       Name="TxtSource"
                       Classes="editor"
                       IsReadOnly="True"
                       TextWrapping="Wrap"
                       AcceptsReturn="True"
                       FontSize="{Binding EditorFontSize}"
                       Background="{DynamicResource Th.Bg}"
                       Foreground="{DynamicResource Th.Text}"
                       BorderThickness="0"
                       Padding="10,6"
                       FontFamily="Cascadia Code,Consolas,monospace"
                       CaretBrush="Transparent" />
            </DockPanel>

            <!-- Vertical divider -->
            <Rectangle Grid.Column="1" Fill="{DynamicResource Th.BorderSubtle}" />

            <!-- Translation -->
            <DockPanel Grid.Column="2">
              <Border DockPanel.Dock="Top"
                      Background="{DynamicResource Th.Panel}"
                      Padding="12,6,12,2">
                <TextBlock Text="{l:T 'TRANSLATION'}" Classes="edlabel" />
              </Border>
              <!-- Words the dictionary does not know; click one for suggestions -->
              <Border DockPanel.Dock="Bottom" Name="SpellBar" IsVisible="False"
                      Background="{DynamicResource Th.Panel}" BorderBrush="{DynamicResource Th.BorderSubtle}"
                      BorderThickness="0,1,0,0" Padding="8,3">
                <WrapPanel Name="SpellWords" />
              </Border>
              <TextBox Name="TxtTranslation"
                       Classes="editor"
                       Text="{Binding TranslationText}"
                       TextWrapping="Wrap"
                       AcceptsReturn="True"
                       FontSize="{Binding EditorFontSize}"
                       Background="{DynamicResource Th.Bg}"
                       Foreground="{DynamicResource Th.TextBright}"
                       BorderThickness="0"
                       Padding="10,6"
                       CaretBrush="{DynamicResource Th.Text}" />
            </DockPanel>

          </Grid>
        </Grid>
      </Border>

    </Grid>

  </DockPanel>
</Window>
