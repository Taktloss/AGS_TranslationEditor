<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:AGSFontEditor.Localization"
        xmlns:vm="using:AGS_TranslationEditor.ViewModels"
        xmlns:models="using:AGS_TranslationEditor.Models"
        xmlns:conv="using:AGS_TranslationEditor.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="AGS_TranslationEditor.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Width="1100" Height="700"
        MinWidth="750" MinHeight="500"
        Background="{StaticResource VsEditorBg}">

  <Window.Resources>
    <conv:BoolToBackgroundConverter x:Key="BoolToBg" />
  </Window.Resources>

  <DockPanel>

    <!-- ═══ Menu Bar ═══ -->
    <Border DockPanel.Dock="Top"
            Background="#3C3C3C"
            BorderBrush="#474747"
            BorderThickness="0,0,0,1">
      <Menu Background="Transparent"
            Foreground="#CCCCCC">
        <MenuItem Header="{l:T '_File'}" Foreground="#CCCCCC">
          <MenuItem Header="{l:T '_Open...'}"    Name="MenuOpen"     InputGesture="Ctrl+O" />
          <MenuItem Header="{l:T '_Save'}"       Name="MenuSave"     InputGesture="Ctrl+S" />
          <MenuItem Header="{l:T 'Save _As...'}"  Name="MenuSaveAs"   InputGesture="Ctrl+Shift+S" />
          <Separator />
          <MenuItem Header="{l:T '_Export'}">
            <MenuItem Header="{l:T 'Export as CSV...'}" Name="MenuExportCSV" />
            <MenuItem Header="{l:T 'Export as PO...'}"  Name="MenuExportPO" />
            <MenuItem Header="{l:T 'Export as _TRA...'}" Name="MenuExportTRA" />
          </MenuItem>
          <Separator />
          <MenuItem Header="{l:T 'E_xit'}" Name="MenuExit" />
        </MenuItem>
        <MenuItem Header="{l:T '_Tools'}" Foreground="#CCCCCC">
          <MenuItem Header="{l:T '_Extract Strings...'}" Name="MenuExtractScript" />
          <MenuItem Header="{l:T '_Game Info...'}"        Name="MenuGameInfo" />
          <MenuItem Header="{l:T 'Create _TRA File...'}"  Name="MenuCreateTRA" />
          <MenuItem Header="{l:T '_Update from Game...'}" Name="MenuMergeGame" />
          <MenuItem Header="{l:T '_Check Translation...'}" Name="MenuCheck" />
          <Separator />
          <MenuItem Header="{l:T '_Install into Game...'}"      Name="MenuInstall" />
          <MenuItem Header="{l:T 'U_ninstall from Game...'}"    Name="MenuUninstall" />
          <MenuItem Header="{l:T 'Create _Player Package...'}"  Name="MenuPack" />
          <MenuItem Header="{l:T '_Font Editor...'}"     Name="MenuFontEditor" />
          <Separator />
          <MenuItem Header="{l:T '_Settings...'}"         Name="MenuSettings" />
        </MenuItem>
        <MenuItem Header="{l:T '_Help'}" Foreground="#CCCCCC">
          <MenuItem Header="{l:T '_About'}" Name="MenuAbout" />
        </MenuItem>
      </Menu>
    </Border>

    <!-- ═══ Toolbar ═══ -->
    <Border DockPanel.Dock="Top"
            Background="#3C3C3C"
            BorderBrush="#474747"
            BorderThickness="0,0,0,1"
            MinHeight="36"
            Padding="6,6">
      <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

        <!-- File -->
        <Button Name="BtnOpen" Classes="vsbtn" ToolTip.Tip="{l:T 'Open (Ctrl+O)'}">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <TextBlock Text="&#128194;" FontSize="13"/>
            <TextBlock Text="{l:T 'Open'}" />
          </StackPanel>
        </Button>
        <Button Name="BtnSave" Classes="vsbtn" ToolTip.Tip="{l:T 'Save (Ctrl+S)'}">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <TextBlock Text="&#128190;" FontSize="13"/>
            <TextBlock Text="{l:T 'Save'}" />
          </StackPanel>
        </Button>

        <!-- Divider -->
        <Rectangle Width="1" Height="18" Fill="#474747" Margin="6,0" VerticalAlignment="Center" />

        <!-- Search -->
        <Border Background="#252526"
                BorderBrush="#474747"
                BorderThickness="1"
                CornerRadius="2"
                Height="24"
                VerticalAlignment="Center">
          <TextBox Name="TxtSearch"
                   Width="180"
                   Watermark="{l:T '  Search...'}"
                   Background="Transparent"
                   Foreground="#CCCCCC"
                   BorderThickness="0"
                   Padding="6,0"
                   FontSize="12"
                   VerticalContentAlignment="Center"
                   CaretBrush="#CCCCCC" />
        </Border>
        <Button Name="BtnFind"     Classes="vsbtn" ToolTip.Tip="{l:T 'Find'}"           Margin="2,0,0,0" Content="{l:T 'Find'}" />
        <Button Name="BtnFindPrev" Classes="vsbtn" ToolTip.Tip="{l:T 'Previous match'}" ToolTip.ShowDelay="300">&#9664;</Button>
        <Button Name="BtnFindNext" Classes="vsbtn" ToolTip.Tip="{l:T 'Next match'}"     ToolTip.ShowDelay="300">&#9654;</Button>

        <!-- Divider -->
        <Rectangle Width="1" Height="18" Fill="#474747" Margin="6,0" VerticalAlignment="Center" />

        <!-- Filter -->
        <ToggleButton Name="BtnFilterUntranslated" Classes="vsbtn"
                      ToolTip.Tip="{l:T 'Show only untranslated entries'}">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <TextBlock Text="&#9873;" />
            <TextBlock Text="{l:T 'Untranslated only'}" />
          </StackPanel>
        </ToggleButton>
        <Button Name="BtnNextUntranslated" Classes="vsbtn" Margin="2,0,0,0"
                ToolTip.Tip="{l:T 'Jump to next untranslated'}">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <TextBlock Text="&#8595;" />
            <TextBlock Text="{l:T 'Next untranslated'}" />
          </StackPanel>
        </Button>
        <Border Background="#252526" BorderBrush="#474747" BorderThickness="1" CornerRadius="2"
                Height="24" Margin="6,0,0,0" VerticalAlignment="Center"
                IsVisible="{Binding IsContextVisible}">
          <TextBox Width="130"
                   Text="{Binding ContextFilter}"
                   Watermark="{l:T '  Character or room...'}"
                   ToolTip.Tip="{l:T 'Show only texts whose context contains this, e.g. a character or a room'}"
                   Background="Transparent" Foreground="#CCCCCC" BorderThickness="0" Padding="6,0"
                   FontSize="12" VerticalContentAlignment="Center" CaretBrush="#CCCCCC" />
        </Border>

        <!-- Divider -->
        <Rectangle Width="1" Height="18" Fill="#474747" Margin="6,0" VerticalAlignment="Center" />
        <Button Name="BtnTranslate" Classes="vsbtn" ToolTip.Tip="{l:T 'Machine-translate the selected entry, or all empty entries (service: Settings)'}">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <TextBlock Text="⚡" />
            <TextBlock Text="{l:T 'Translate'}" />
          </StackPanel>
        </Button>

        <!-- Divider -->
        <Rectangle Width="1" Height="18" Fill="#474747" Margin="6,0" VerticalAlignment="Center" />
        <ToggleButton Name="BtnLive" Classes="vsbtn"
                      IsChecked="{Binding Live.IsActive}"
                      ToolTip.Tip="{l:T 'Live mode: see the texts of the running game and correct them while playing (Linux)'}">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <TextBlock Text="&#9679;" Foreground="#E06C75" />
            <TextBlock Text="{l:T 'Live'}" />
          </StackPanel>
        </ToggleButton>

      </WrapPanel>
    </Border>

    <!-- ═══ Status Bar (VS Code blue) ═══ -->
    <Border DockPanel.Dock="Bottom"
            Background="#007ACC"
            Height="22">
      <Grid ColumnDefinitions="Auto,*,Auto,180" Margin="8,0">

        <!-- Left: filename indicator -->
        <TextBlock Grid.Column="0"
                   Text="&#9679; "
                   Foreground="#FFFFFF"
                   VerticalAlignment="Center"
                   FontSize="11"
                   IsVisible="{Binding DocumentChanged}" />

        <!-- Center: status message -->
        <TextBlock Grid.Column="1"
                   Text="{Binding FileStatusText}"
                   Foreground="#FFFFFFCC"
                   VerticalAlignment="Center"
                   FontSize="11" />

        <!-- Right: entry count -->
        <TextBlock Grid.Column="2"
                   Text="{Binding EntriesCountText}"
                   Foreground="#FFFFFF"
                   VerticalAlignment="Center"
                   FontSize="11"
                   FontWeight="SemiBold"
                   Margin="0,0,12,0" />

        <!-- Progress -->
        <ProgressBar Grid.Column="3"
                     Value="{Binding ProgressValue}"
                     Minimum="0" Maximum="100"
                     Height="4"
                     VerticalAlignment="Center"
                     Background="#0E4F80"
                     Foreground="#FFFFFF"
                     CornerRadius="2"
                     Margin="0,0,8,0" />
      </Grid>
    </Border>

    <!-- ═══ Check Panel ═══ -->
    <Border DockPanel.Dock="Right"
            Width="360"
            Background="#252526"
            BorderBrush="#474747"
            BorderThickness="1,0,0,0"
            IsVisible="{Binding ShowCheckPanel}">
      <DockPanel>
        <Border DockPanel.Dock="Top"
                Padding="10,6"
                BorderBrush="#474747"
                BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="4">
              <TextBlock Text="{l:T 'CHECK'}"
                         FontSize="11"
                         FontWeight="SemiBold"
                         Foreground="#CCCCCC" />
              <TextBlock Text="{Binding CheckSummary}"
                         FontSize="11"
                         Foreground="#8A8A8A"
                         TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" Classes="vsbtn" VerticalAlignment="Top"
                    Command="{Binding CloseCheckPanelCommand}"
                    ToolTip.Tip="{l:T 'Close'}">✕</Button>
          </Grid>
        </Border>
        <ListBox Name="LstCheck"
                 ItemsSource="{Binding CheckItems}"
                 SelectedItem="{Binding SelectedCheckItem}"
                 Background="#1E1E1E">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="models:CheckItem">
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding Header}"
                           Foreground="{Binding Color}"
                           FontSize="10" />
                <TextBlock Text="{Binding Text}"
                           TextWrapping="Wrap"
                           Foreground="#D4D4D4"
                           FontSize="12" />
                <TextBlock Text="{Binding Message}"
                           TextWrapping="Wrap"
                           Foreground="#8A8A8A"
                           FontSize="10" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- ═══ Live Panel ═══ -->
    <Border DockPanel.Dock="Right"
            Width="340"
            Background="#252526"
            BorderBrush="#474747"
            BorderThickness="1,0,0,0"
            IsVisible="{Binding Live.IsActive}">
      <DockPanel>
        <Border DockPanel.Dock="Top"
                Padding="10,6"
                BorderBrush="#474747"
                BorderThickness="0,0,0,1">
          <StackPanel Spacing="4">
            <TextBlock Text="{l:T 'LIVE'}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="#CCCCCC" />
            <TextBlock Text="{Binding Live.StatusText}"
                       FontSize="11"
                       Foreground="#8A8A8A"
                       TextWrapping="Wrap" />
            <CheckBox IsChecked="{Binding Live.AutoSave}"
                      FontSize="11"
                      Foreground="#CCCCCC"
                      Content="{l:T 'Save the TRS after each correction'}" />
          </StackPanel>
        </Border>
        <ListBox Name="LstLive"
                 ItemsSource="{Binding Live.Items}"
                 SelectedItem="{Binding Live.SelectedItem}"
                 Background="#1E1E1E">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="models:LiveItem">
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding Shown}"
                           TextWrapping="Wrap"
                           Foreground="#D4D4D4"
                           FontSize="12" />
                <TextBlock Text="{Binding Original}"
                           TextWrapping="Wrap"
                           Foreground="#6A6A6A"
                           FontSize="10" />
                <TextBlock Text="{Binding Note}"
                           Foreground="#C586C0"
                           FontSize="10"
                           IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- ═══ Main Content ═══ -->
    <Grid RowDefinitions="*,4,130" Name="MainContentGrid">

      <!-- Translation List -->
      <Grid Grid.Row="0">
        <DataGrid Name="DgvTranslation"
                  ItemsSource="{Binding DisplayedEntries}"
                  SelectedItem="{Binding SelectedEntry}"
                  AutoGenerateColumns="False"
                  CanUserSortColumns="True"
                  SelectionMode="Single">
          <DataGrid.Styles>
            <Style Selector="DataGridRow" x:DataType="models:TranslationEntry">
              <Setter Property="Background"
                      Value="{Binding IsUntranslated, Converter={StaticResource BoolToBg}}" />
            </Style>
          </DataGrid.Styles>
          <DataGrid.Columns>
            <DataGridTextColumn Header="#"
                                Binding="{Binding RowIndex}"
                                Width="48"
                                IsReadOnly="True">
              <DataGridTextColumn.CellTheme>
                <ControlTheme TargetType="DataGridCell">
                  <Setter Property="Foreground" Value="#5A5A5A" />
                  <Setter Property="FontSize" Value="11" />
                </ControlTheme>
              </DataGridTextColumn.CellTheme>
            </DataGridTextColumn>
            <DataGridTextColumn Header="{l:T 'Source (Original)'}"
                                Binding="{Binding Key}"
                                Width="*"
                                IsReadOnly="True" />
            <DataGridTextColumn Header="{l:T 'Translation'}"
                                Binding="{Binding Value}"
                                Width="*" />
            <!-- Shown by code when context is enabled: columns are not part of the visual tree -->
            <DataGridTextColumn Header="{l:T 'Context'}"
                                Binding="{Binding Origin}"
                                Width="200"
                                IsReadOnly="True"
                                IsVisible="False">
              <DataGridTextColumn.CellTheme>
                <ControlTheme TargetType="DataGridCell">
                  <Setter Property="Foreground" Value="#8A8A8A" />
                  <Setter Property="FontSize" Value="11" />
                </ControlTheme>
              </DataGridTextColumn.CellTheme>
            </DataGridTextColumn>
          </DataGrid.Columns>
        </DataGrid>

        <!-- Loading overlay -->
        <Border Background="#CC1E1E1E" IsVisible="{Binding IsLoading}" ZIndex="10">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
            <ProgressBar IsIndeterminate="True" Width="200" Height="4" />
            <TextBlock Text="{l:T 'Loading...'}" Foreground="#CCCCCC" HorizontalAlignment="Center" FontSize="13"/>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Drag handle -->
      <GridSplitter Grid.Row="1"
                    ResizeDirection="Rows"
                    Background="#474747"
                    Height="4" />

      <!-- ═══ Editor Panel (VS Code bottom panel style) ═══ -->
      <Border Grid.Row="2" Background="#252526">
        <Grid RowDefinitions="26,*">

          <!-- Panel header tabs -->
          <Border Grid.Row="0"
                  Background="#252526"
                  BorderBrush="#474747"
                  BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
              <Border Background="#1E1E1E"
                      BorderBrush="#007ACC"
                      BorderThickness="0,2,0,0"
                      Padding="14,0">
                <TextBlock Text="{l:T 'EDITOR'}"
                           Foreground="#CCCCCC"
                           FontSize="11"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
              </Border>
            </StackPanel>
          </Border>

          <!-- Source + Translation side by side -->
          <Grid Grid.Row="1" ColumnDefinitions="*,1,*">

            <!-- Source -->
            <DockPanel Margin="0">
              <Border DockPanel.Dock="Top"
                      Background="#252526"
                      Padding="10,4">
                <TextBlock Text="{l:T 'SOURCE'}"
                           FontSize="10"
                           FontWeight="SemiBold"
                           LetterSpacing="1.5"
                           Foreground="#8A8A8A" />
              </Border>
              <TextBox Text="{Binding SourceText}"
                       Name="TxtSource"
                       IsReadOnly="True"
                       TextWrapping="Wrap"
                       AcceptsReturn="True"
                       FontSize="{Binding EditorFontSize}"
                       Background="#1E1E1E"
                       Foreground="#8A8A8A"
                       BorderThickness="0"
                       Padding="10,6"
                       FontFamily="Cascadia Code,Consolas,monospace"
                       CaretBrush="Transparent" />
            </DockPanel>

            <!-- Vertical divider -->
            <Rectangle Grid.Column="1" Fill="#474747" />

            <!-- Translation -->
            <DockPanel Grid.Column="2">
              <Border DockPanel.Dock="Top"
                      Background="#252526"
                      Padding="10,4">
                <TextBlock Text="{l:T 'TRANSLATION'}"
                           FontSize="10"
                           FontWeight="SemiBold"
                           LetterSpacing="1.5"
                           Foreground="#007ACC" />
              </Border>
              <TextBox Name="TxtTranslation"
                       Text="{Binding TranslationText}"
                       TextWrapping="Wrap"
                       AcceptsReturn="True"
                       FontSize="{Binding EditorFontSize}"
                       Background="#1E1E1E"
                       Foreground="#D4D4D4"
                       BorderThickness="0"
                       Padding="10,6"
                       CaretBrush="#AEAFAD" />
            </DockPanel>

          </Grid>
        </Grid>
      </Border>

    </Grid>

  </DockPanel>
</Window>
