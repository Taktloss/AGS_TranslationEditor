<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AGS_TranslationEditor.App"
             xmlns:local="using:AGS_TranslationEditor"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>


    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
        <!-- Icons, buttons, menus and panels shared with the font and image editors -->
        <StyleInclude Source="avares://AGSFontEditor/Theming/Controls.axaml"/>

        <!-- DataGrid VS Code look -->
        <Style Selector="DataGrid">
            <Setter Property="Background"            Value="{DynamicResource Th.Bg}" />
            <Setter Property="RowBackground"         Value="Transparent" />
            <Setter Property="BorderThickness"       Value="0" />
            <Setter Property="GridLinesVisibility"   Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Th.BorderSubtle}" />
            <Setter Property="FontSize"              Value="13" />
            <Setter Property="Foreground"            Value="{DynamicResource Th.Text}" />
        </Style>
        <!-- A finished room or character in the progress panel -->
        <Style Selector="ProgressBar.done">
            <Setter Property="Foreground" Value="{DynamicResource Th.Success}" />
        </Style>
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background"    Value="{DynamicResource Th.Panel}" />
            <Setter Property="Foreground"    Value="{DynamicResource Th.Text}" />
            <Setter Property="FontSize"      Value="11" />
            <Setter Property="FontWeight"    Value="SemiBold" />
            <Setter Property="Height"        Value="28" />
            <!-- Lines the title up with the cell text (cell padding 8 + the text column's own margin) -->
            <Setter Property="Padding"       Value="20,0,8,0" />
            <Setter Property="BorderBrush"   Value="{DynamicResource Th.Border}" />
            <!-- Right edge marks where a column can be dragged wider or narrower -->
            <Setter Property="BorderThickness" Value="0,0,1,1" />
        </Style>
        <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="{DynamicResource Th.Selection}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <!-- No frame around the current cell: the row selection already shows where you are -->
        <Style Selector="DataGridCell:current /template/ Rectangle#CurrencyVisual, DataGridCell:focus /template/ Grid#FocusVisual">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <!-- The source and translation boxes keep their background while typing -->
        <Style Selector="TextBox.editor:pointerover /template/ Border#PART_BorderElement, TextBox.editor:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background"      Value="{DynamicResource Th.Bg}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="DataGridCell">
            <Setter Property="Padding" Value="8,4" />
        </Style>
    </Application.Styles>
</Application>
