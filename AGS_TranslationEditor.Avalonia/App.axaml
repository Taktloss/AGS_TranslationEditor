<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AGS_TranslationEditor.App"
             xmlns:local="using:AGS_TranslationEditor"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>

        <!-- VS Code-style flat toolbar button -->
        <Style Selector="Button.vsbtn">
            <Setter Property="Background"   Value="Transparent" />
            <Setter Property="Foreground"   Value="{DynamicResource Th.Text}" />
            <Setter Property="BorderBrush"  Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding"      Value="8,4" />
            <Setter Property="Height"       Value="28" />
            <Setter Property="MinWidth"     Value="32" />
            <Setter Property="FontSize"     Value="12" />
            <Setter Property="CornerRadius" Value="2" />
        </Style>
        <Style Selector="Button.vsbtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Th.Hover}" />
        </Style>
        <Style Selector="Button.vsbtn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Th.Pressed}" />
        </Style>

        <!-- VS Code-style flat toggle button -->
        <Style Selector="ToggleButton.vsbtn">
            <Setter Property="Background"      Value="Transparent" />
            <Setter Property="Foreground"      Value="{DynamicResource Th.Text}" />
            <Setter Property="BorderBrush"     Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding"         Value="8,4" />
            <Setter Property="Height"          Value="28" />
            <Setter Property="FontSize"        Value="12" />
            <Setter Property="CornerRadius"    Value="2" />
        </Style>
        <Style Selector="ToggleButton.vsbtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Th.Hover}" />
        </Style>
        <Style Selector="ToggleButton.vsbtn:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Th.Pressed}" />
        </Style>
        <Style Selector="ToggleButton.vsbtn:checked">
            <Setter Property="Foreground" Value="{DynamicResource Th.TextStrong}" />
        </Style>

        <!-- DataGrid VS Code look -->
        <Style Selector="DataGrid">
            <Setter Property="Background"            Value="{DynamicResource Th.Bg}" />
            <Setter Property="RowBackground"         Value="Transparent" />
            <Setter Property="BorderThickness"       Value="0" />
            <Setter Property="GridLinesVisibility"   Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Th.BorderSubtle}" />
            <Setter Property="FontSize"              Value="13" />
            <Setter Property="Foreground"            Value="{DynamicResource Th.Text}" />
        </Style>
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background"    Value="{DynamicResource Th.Panel}" />
            <Setter Property="Foreground"    Value="{DynamicResource Th.Text}" />
            <Setter Property="FontSize"      Value="11" />
            <Setter Property="FontWeight"    Value="SemiBold" />
            <Setter Property="Height"        Value="28" />
            <Setter Property="Padding"       Value="8,0" />
            <Setter Property="BorderBrush"   Value="{DynamicResource Th.Border}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="{DynamicResource Th.Selection}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="DataGridCell">
            <Setter Property="Padding" Value="8,4" />
        </Style>
    </Application.Styles>
</Application>
