<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:AGSFontEditor.Localization"
        xmlns:vm="using:AGSFontEditor.ViewModels"
        xmlns:controls="using:AGSFontEditor.Controls"
        x:Class="AGSFontEditor.Views.SpriteEditorWindow"
        x:DataType="vm:SpriteEditorViewModel"
        Title="{l:T 'AGS Image Editor'}"
        Width="1280" Height="820" MinWidth="900" MinHeight="600"
        RequestedThemeVariant="Dark"
        Background="#1E1E1E">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
  </Window.KeyBindings>

  <Window.Styles>
    <Style Selector="Button.tool">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#CCCCCC" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="CornerRadius" Value="2" />
    </Style>
    <Style Selector="Button.tool:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#505050" />
    </Style>
    <Style Selector="TextBlock.header">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="1.5" />
      <Setter Property="Foreground" Value="#8A8A8A" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#8A8A8A" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </Window.Styles>

  <DockPanel>

    <!-- Toolbar -->
    <Border DockPanel.Dock="Top" Background="#3C3C3C" BorderBrush="#474747" BorderThickness="0,0,0,1" Padding="6,3">
      <StackPanel Orientation="Horizontal" Spacing="2">
        <Button Name="BtnOpenGame" Classes="tool" Content="{l:T 'Open Game...'}" ToolTip.Tip="{l:T 'Load the sprites (images) of an AGS game (exe, .ags, game28.dta)'}" IsEnabled="{Binding IsIdle}" />
        <Rectangle Width="1" Height="18" Fill="#474747" Margin="6,0" />
        <Button Name="BtnExportSelected" Classes="tool" Content="{l:T 'Save Image as PNG...'}" ToolTip.Tip="{l:T 'Save the selected sprite as PNG, e.g. to edit it in another program'}" IsEnabled="{Binding HasSelection}" />
        <Button Name="BtnExportList" Classes="tool" Content="{l:T 'Save Listed as PNG...'}" ToolTip.Tip="{l:T 'Save all sprites in the list as PNG files into a folder'}" IsEnabled="{Binding HasGame}" />
        <Rectangle Width="1" Height="18" Fill="#474747" Margin="6,0" />
        <Button Name="BtnImport" Classes="tool" Content="{l:T 'Replace with PNG...'}" ToolTip.Tip="{l:T 'Replace the selected sprite with a PNG file'}" IsEnabled="{Binding HasSelection}" />
        <Button Name="BtnImportFolder" Classes="tool" Content="{l:T 'Load PNG Folder...'}" ToolTip.Tip="{l:T 'Take all changed PNG files of a folder (named sprite00042.png or 42.png)'}" IsEnabled="{Binding HasGame}" />
        <Rectangle Width="1" Height="18" Fill="#474747" Margin="6,0" />
        <Button Name="BtnBuildPatch" Classes="tool" Content="{l:T 'Create Sprite Patch...'}" ToolTip.Tip="{l:T 'Write acsprset.spr and sprindex.dat with all changed sprites into a folder'}" IsEnabled="{Binding HasChanges}" />
      </StackPanel>
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Background="#007ACC" Height="22">
      <Grid ColumnDefinitions="*,Auto" Margin="8,0">
        <TextBlock Text="{Binding StatusText}" Foreground="#FFFFFF" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <ProgressBar Grid.Column="1" IsIndeterminate="True" IsVisible="{Binding IsBusy}" Width="120" Height="4" />
      </Grid>
    </Border>

    <Grid ColumnDefinitions="260,4,*,4,320">

      <!-- Sprite list -->
      <DockPanel Background="#252526">
        <TextBlock DockPanel.Dock="Top" Classes="header" Text="{l:T 'SPRITES'}" Margin="10,8,10,4" />
        <StackPanel DockPanel.Dock="Top" Margin="8,0,8,6" Spacing="4">
          <TextBox Text="{Binding FilterText}" FontSize="12" Watermark="{l:T 'Number, 100-200 or min. size 300x200'}" />
          <CheckBox IsChecked="{Binding OnlyLarge}" Content="{l:T 'Hide small sprites'}" FontSize="12" />
          <CheckBox IsChecked="{Binding OnlyChanged}" Content="{l:T 'Only changed sprites'}" FontSize="12" />
          <TextBlock Text="{Binding CountText}" Classes="muted" />
        </StackPanel>
        <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:SpriteItemViewModel">
              <Grid ColumnDefinitions="52,*" Margin="0,1">
                <Border Width="48" Height="48" Background="#3A3A3A">
                  <Image Source="{Binding Thumbnail}" Stretch="Uniform" StretchDirection="DownOnly" RenderOptions.BitmapInterpolationMode="None" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0" Spacing="1">
                  <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Foreground="#D4D4D4" />
                  <TextBlock Text="{Binding SizeText}" Classes="muted" />
                  <TextBlock Text="{l:T 'changed'}" IsVisible="{Binding IsChanged}" Foreground="#E0A040" FontSize="11" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <GridSplitter Grid.Column="1" Background="#474747" ResizeDirection="Columns" />

      <!-- Image -->
      <DockPanel Grid.Column="2">
        <Border DockPanel.Dock="Top" Background="#252526" Padding="8,4">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding SelectedInfo}" VerticalAlignment="Center" Foreground="#CCCCCC" FontSize="12" />
            <TextBlock Text="{l:T 'Zoom:'}" VerticalAlignment="Center" Foreground="#CCCCCC" FontSize="12" Margin="12,0,0,0" />
            <ComboBox ItemsSource="{Binding ZoomLevels}" SelectedItem="{Binding Zoom}" FontSize="12" />
            <CheckBox IsChecked="{Binding ShowOriginal}" Content="{l:T 'Show original'}" FontSize="12" />
          </StackPanel>
        </Border>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding SelectionText}" Classes="muted" Margin="8,4" />
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#1E1E1E">
          <controls:SpriteCanvas Name="Canvas" Source="{Binding Image}" Zoom="{Binding Zoom}" Selection="{Binding Selection}"
                                 Margin="12" HorizontalAlignment="Left" VerticalAlignment="Top" />
        </ScrollViewer>
      </DockPanel>

      <GridSplitter Grid.Column="3" Background="#474747" ResizeDirection="Columns" />

      <!-- Tools -->
      <ScrollViewer Grid.Column="4" Background="#252526">
        <StackPanel Margin="10" Spacing="8" IsEnabled="{Binding HasSelection}">
          <TextBlock Classes="header" Text="{l:T 'COLOR'}" />
          <Grid ColumnDefinitions="28,*">
            <Border Width="22" Height="22" Background="{Binding ColorBrush}" BorderBrush="#6A6A6A" BorderThickness="1" />
            <TextBox Grid.Column="1" Text="{Binding ColorText}" FontSize="12" Margin="4,0,0,0" />
          </Grid>
          <TextBlock Classes="muted" Text="{l:T 'Ctrl+click on the image picks a color. #RRGGBB, or #AARRGGBB with transparency (#00000000 is fully transparent).'}" />

          <TextBlock Classes="header" Text="{l:T 'AREA'}" Margin="0,8,0,0" />
          <TextBlock Classes="muted" Text="{l:T 'Drag over the image to select an area; right click removes the selection.'}" />
          <Button Content="{l:T 'Fill Selection with Color'}" Command="{Binding FillSelectionCommand}" HorizontalAlignment="Stretch" />

          <TextBlock Classes="header" Text="{l:T 'TEXT'}" Margin="0,8,0,0" />
          <TextBox Text="{Binding TextToDraw}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" FontSize="12"
                   Watermark="{l:T 'Text to write into the image'}" />
          <Grid ColumnDefinitions="*,Auto">
            <ComboBox ItemsSource="{Binding Fonts}" SelectedItem="{Binding SelectedFont}" HorizontalAlignment="Stretch" FontSize="12" />
            <Button Name="BtnAddFont" Grid.Column="1" Content="{l:T 'Font File...'}" Margin="4,0,0,0" FontSize="12"
                    ToolTip.Tip="{l:T 'Write with a font file, e.g. your font with the characters of the translation'}" />
          </Grid>
          <ComboBox ItemsSource="{Binding AlignNames}" SelectedIndex="{Binding AlignIndex}" HorizontalAlignment="Stretch" FontSize="12" />
          <Grid ColumnDefinitions="Auto,28,*">
            <CheckBox IsChecked="{Binding UseOutline}" Content="{l:T 'Outline'}" FontSize="12" />
            <Border Grid.Column="1" Width="22" Height="22" Background="{Binding OutlineBrush}" BorderBrush="#6A6A6A" BorderThickness="1" Margin="4,0,0,0" />
            <TextBox Grid.Column="2" Text="{Binding OutlineText}" FontSize="12" Margin="4,0,0,0" IsEnabled="{Binding UseOutline}" />
          </Grid>
          <Button Content="{l:T 'Write Text'}" Command="{Binding DrawTextCommand}" HorizontalAlignment="Stretch" />
          <TextBlock Classes="muted" Text="{l:T 'The text is written with a game font in the color above, centered vertically in the selection (or the whole image).'}" />

          <TextBlock Classes="header" Text="{l:T 'CHANGES'}" Margin="0,8,0,0" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Content="{l:T 'Undo'}" Command="{Binding UndoCommand}" ToolTip.Tip="Ctrl+Z" />
            <Button Content="{l:T 'Back to Original'}" Command="{Binding RevertCommand}" />
          </StackPanel>
          <TextBlock Classes="muted" Text="{l:T 'For bigger changes, save the image as PNG, edit it in a paint program (GIMP, Krita, ...) and load it again. Changes are kept until the window is closed; the sprite patch also saves the changed images as PNG.'}" />
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
